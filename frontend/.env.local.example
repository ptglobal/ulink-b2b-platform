# ULink frontend (Next.js) env — copy to .env.local

# Directus API base URL
DIRECTUS_URL=http://localhost:8055
# Optional static token for server-side writes (e.g. RFQ submit).
# Create in Directus → Settings → Access Tokens. Leave blank to rely on public role permissions.
DIRECTUS_TOKEN=

# Secret used by Directus Flow -> /api/revalidate
REVALIDATE_SECRET=replace-with-long-random-string

# Shared internal bearer token for Directus Flow -> /api/internal/*
INTERNAL_API_TOKEN=replace-with-long-random-string

# Redis (used by /api/sku for the <50ms cached SKU lookup)
REDIS_URL=redis://localhost:6379

# Public site URL (sitemap, robots, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anti-spam — Cloudflare Turnstile (RFQ / Contact forms)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SMTP for RFQ notification emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ULink <no-reply@ulink.local>

# ERP outbound outbox worker
ERP_SYNC_ENABLED=false
ERP_WEBHOOK_URL=http://localhost:3000/api/mock/erp
ERP_WEBHOOK_TOKEN=replace-with-long-random-string
ERP_OUTBOX_BATCH_SIZE=20
ERP_OUTBOX_MAX_ATTEMPTS=3
