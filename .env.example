# ULink B2B Platform — backend / infrastructure env
# Copy to .env and replace every value before deploying.
# (.env is git-ignored — never commit real secrets.)

# --- PostgreSQL ---
POSTGRES_DB=ulink
POSTGRES_USER=ulink
POSTGRES_PASSWORD=change-me-strong-password

# --- Directus ---
# Generate KEY and SECRET with random strings, e.g.:  openssl rand -hex 32
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_ADMIN_EMAIL=admin@ulink.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin-password
DIRECTUS_PUBLIC_URL=http://localhost:8055

# Directus upload policy
FILES_MAX_UPLOAD_SIZE=10mb
FILES_MIME_TYPE_ALLOW_LIST=image/jpeg,image/png,image/webp,image/svg+xml,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=/directus/uploads

# --- Mail ---
# Local dev uses Mailpit. Prod can override these to Resend SMTP.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ULINK <no-reply@ulink.com>

# --- Google OAuth 2.0 (SSO) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
AUTH_PROVIDERS=google
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_GOOGLE_IDENTIFIER_KEY=email
AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=false
AUTH_GOOGLE_DEFAULT_ROLE_ID=e11b0e50-3030-410c-9999-000000000003
AUTH_GOOGLE_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/callback
