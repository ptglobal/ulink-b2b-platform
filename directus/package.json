{
  "name": "ulink-directus-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creates ULink collections + roles in a running Directus instance.",
  "scripts": {
    "bootstrap": "node bootstrap.mjs",
    "verify": "node verify_bootstrap.mjs",
    "verify:commercial-import": "node verify_commercial_data_import.mjs",
    "verify:onboarding": "node verify_onboarding.mjs",
    "verify:reset-password": "node verify_password_reset.mjs",
    "verify:rfq-notify": "node --import ../frontend/node_modules/tsx/dist/loader.mjs verify_rfq_notification_flow.mjs",
    "media:verify": "node verify_media_policy.mjs",
    "media:cleanup": "node media-cleanup.mjs",
    "rbac:seed": "node rbac_seed.mjs",
    "rbac:verify": "node rbac_verify.mjs",
    "openapi:export": "node export-openapi.mjs"
  },
  "dependencies": {
    "@directus/sdk": "^17.0.1",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5"
  }
}
