{
  "paths": {
    "/otp/issue": {
      "post": {
        "tags": ["OTP"],
        "summary": "Issue an OTP code",
        "description": "Public endpoint used before registration or email-based password change verification.",
        "operationId": "otpIssue",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "purpose"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "purpose": { "type": "string", "enum": ["register", "login-2fa"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "sent": { "type": "boolean" },
                        "expires_in_seconds": { "type": "integer" },
                        "debug_code": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/otp/verify": {
      "post": {
        "tags": ["OTP"],
        "summary": "Verify an OTP code",
        "operationId": "otpVerify",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "purpose", "code"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "purpose": { "type": "string", "enum": ["register", "login-2fa"] },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "verified": { "type": "boolean" },
                        "verified_token": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customer-onboarding/register": {
      "post": {
        "tags": ["Customer Onboarding"],
        "summary": "Register a new customer account",
        "description": "Public endpoint. Requires OTP verification and consent fields.",
        "operationId": "customerOnboardingRegister",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["company_name", "contact_name", "email", "phone", "password", "confirm_password", "agree", "agree_at", "verified_token"],
                "properties": {
                  "company_name": { "type": "string", "example": "ACME Corp" },
                  "contact_name": { "type": "string", "example": "Nguyen Van A" },
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "phone": { "type": "string", "example": "0987654321" },
                  "password": { "type": "string", "format": "password", "example": "SecurePass123!" },
                  "confirm_password": { "type": "string", "format": "password", "example": "SecurePass123!" },
                  "agree": { "type": "boolean", "example": true },
                  "agree_at": { "type": "string", "format": "date-time", "example": "2026-06-19T12:00:00.000Z" },
                  "verified_token": { "type": "string", "example": "vt_..." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user_id": { "type": "string", "format": "uuid" },
                        "customer_id": { "type": "integer" },
                        "status": { "type": "string", "example": "active" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "OTP verification missing or expired" },
          "409": { "description": "User or customer with this email already exists" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/password-reset-request/send": {
      "post": {
        "tags": ["Password Reset"],
        "summary": "Send a password reset email",
        "description": "Public endpoint. Always returns success to avoid email enumeration.",
        "operationId": "passwordResetSend",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "purpose": { "type": "string", "enum": ["forgot", "change"], "example": "forgot" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset email queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "sent": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/password-reset-request/reset": {
      "post": {
        "tags": ["Password Reset"],
        "summary": "Reset a password using a token",
        "operationId": "passwordResetReset",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "password", "confirm_password"],
                "properties": {
                  "token": { "type": "string", "example": "reset-token-from-email" },
                  "password": { "type": "string", "format": "password" },
                  "confirm_password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "ok": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/password-change/change": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Change password after OTP verification",
        "operationId": "changePassword",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "verified_token", "new_password", "confirm_password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "verified_token": { "type": "string", "example": "vt_..." },
                  "new_password": { "type": "string", "format": "password" },
                  "confirm_password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "ok": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commercial-import/preview": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Preview CSV import",
        "operationId": "commercialImportPreview",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "customers" },
                  "csvText": { "type": "string", "example": "erp_ref,company_name,email\nERP-001,ACME,a@acme.vn" },
                  "allowPartial": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "collection": { "type": "string" },
                        "mode": { "type": "string", "example": "preview" },
                        "allowPartial": { "type": "boolean" },
                        "counts": {
                          "type": "object",
                          "properties": {
                            "created": { "type": "integer" },
                            "updated": { "type": "integer" },
                            "skipped": { "type": "integer" },
                            "failed": { "type": "integer" }
                          }
                        },
                        "rows": { "type": "array" },
                        "errorRows": { "type": "array" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commercial-import/commit": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Commit CSV import",
        "operationId": "commercialImportCommit",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "customers" },
                  "csvText": { "type": "string", "example": "erp_ref,company_name,email\nERP-001,ACME,a@acme.vn" },
                  "allowPartial": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import committed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "collection": { "type": "string" },
                        "mode": { "type": "string", "example": "commit" },
                        "allowPartial": { "type": "boolean" },
                        "counts": {
                          "type": "object",
                          "properties": {
                            "created": { "type": "integer" },
                            "updated": { "type": "integer" },
                            "skipped": { "type": "integer" },
                            "failed": { "type": "integer" }
                          }
                        },
                        "rows": { "type": "array" },
                        "errorRows": { "type": "array" },
                        "committed": { "type": "boolean" },
                        "aborted": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/media-policy/soft-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Soft-delete a file",
        "operationId": "mediaPolicySoftDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "id": { "type": "string", "format": "uuid" },
                  "reason": { "type": "string", "example": "No longer needed" },
                  "source": { "type": "string", "example": "manual-test" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File soft-deleted" }
        }
      }
    },
    "/media-policy/hard-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Hard-delete a file permanently",
        "description": "Admin only. confirmFileId must match fileId.",
        "operationId": "mediaPolicyHardDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId", "confirmHardDelete", "confirmFileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "confirmHardDelete": { "type": "boolean" },
                  "confirmFileId": { "type": "string", "format": "uuid" },
                  "reason": { "type": "string", "example": "Security incident" },
                  "source": { "type": "string", "example": "manual-test" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File permanently deleted" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Login: POST /auth/login {email, password} -> access_token"
      }
    }
  }
}
