{
  "paths": {
    "/customer-onboarding/register": {
      "post": {
        "tags": ["Customer Onboarding"],
        "summary": "Register a new customer account",
        "description": "Public endpoint — no auth required.",
        "operationId": "customerOnboardingRegister",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["company_name", "contact_name", "email", "phone", "password", "confirm_password"],
                "properties": {
                  "company_name": { "type": "string", "example": "ACME Corp" },
                  "contact_name": { "type": "string", "example": "Nguyen Van A" },
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "phone": { "type": "string", "example": "0987654321" },
                  "password": { "type": "string", "format": "password", "example": "SecurePass123!" },
                  "confirm_password": { "type": "string", "format": "password", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created (user active, customer inactive — pending Sales approval)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user_id": { "type": "string", "format": "uuid" },
                        "customer_id": { "type": "integer" },
                        "status": { "type": "string", "example": "inactive" }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": { "description": "User or customer with this email already exists" },
          "422": { "description": "Validation error (missing fields, password mismatch)" }
        }
      }
    },
    "/commercial-import/preview": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Preview CSV import",
        "operationId": "commercialImportPreview",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "products" },
                  "csvText": { "type": "string", "example": "name,slug\nTest,test-slug" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "valid": { "type": "integer" },
                        "invalid": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commercial-import/commit": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Commit CSV import",
        "operationId": "commercialImportCommit",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "products" },
                  "csvText": { "type": "string", "example": "name,slug\nTest,test-slug" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import committed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "inserted": { "type": "integer" },
                        "updated": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/media-policy/soft-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Soft-delete a file",
        "operationId": "mediaPolicySoftDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "reason": { "type": "string", "example": "No longer needed" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File soft-deleted" }
        }
      }
    },
    "/media-policy/hard-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Hard-delete a file permanently",
        "description": "Admin only. confirmFileId must match fileId.",
        "operationId": "mediaPolicyHardDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId", "confirmHardDelete", "confirmFileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "confirmHardDelete": { "type": "boolean" },
                  "confirmFileId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File permanently deleted" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Login: POST /auth/login {email, password} -> access_token"
      }
    }
  }
}
