{
  "paths": {
    "/customer-onboarding/register": {
      "post": {
        "tags": ["Customer Onboarding"],
        "summary": "Register a new customer account",
        "description": "Public endpoint — no auth required.",
        "operationId": "customerOnboardingRegister",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["company_name", "contact_name", "email", "phone", "password", "confirm_password"],
                "properties": {
                  "company_name": { "type": "string", "example": "ACME Corp" },
                  "contact_name": { "type": "string", "example": "Nguyen Van A" },
                  "email": { "type": "string", "format": "email", "example": "a@acme.vn" },
                  "phone": { "type": "string", "example": "0987654321" },
                  "password": { "type": "string", "format": "password", "example": "SecurePass123!" },
                  "confirm_password": { "type": "string", "format": "password", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created (user active, customer active)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user_id": { "type": "string", "format": "uuid" },
                        "customer_id": { "type": "integer" },
                        "status": { "type": "string", "example": "active" }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": { "description": "User or customer with this email already exists" },
          "422": { "description": "Validation error (missing fields, password mismatch)" }
        }
      }
    },
    "/auth/login/google": {
      "get": {
        "tags": ["Google OAuth"],
        "summary": "Initiate Google OAuth 2.0 login",
        "description": "Redirects to Google consent screen. On success: if email exists in directus_users, logs in and returns token via callback. If email does not exist and ALLOW_PUBLIC_REGISTRATION=false, returns error — frontend should redirect to registration page.",
        "operationId": "googleOAuthLogin",
        "security": [],
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uri", "example": "http://localhost:3000/auth/callback" },
            "description": "Frontend callback URL that receives the access/refresh tokens"
          }
        ],
        "responses": {
          "302": { "description": "Redirect to Google consent screen" },
          "403": { "description": "Email not found and public registration disabled — redirect user to signup" }
        }
      }
    },
    "/auth/login/google/callback": {
      "get": {
        "tags": ["Google OAuth"],
        "summary": "Google OAuth callback (handled by Directus)",
        "description": "Directus handles this internally. On success, redirects to the frontend redirect URL with access_token and refresh_token as query params.",
        "operationId": "googleOAuthCallback",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Authorization code from Google (handled automatically)"
          }
        ],
        "responses": {
          "302": { "description": "Redirect to frontend with access_token & refresh_token" }
        }
      }
    },
    "/commercial-import/preview": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Preview CSV import",
        "operationId": "commercialImportPreview",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "products" },
                  "csvText": { "type": "string", "example": "name,slug\nTest,test-slug" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "valid": { "type": "integer" },
                        "invalid": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commercial-import/commit": {
      "post": {
        "tags": ["Commercial Import"],
        "summary": "Commit CSV import",
        "operationId": "commercialImportCommit",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collection", "csvText"],
                "properties": {
                  "collection": { "type": "string", "example": "products" },
                  "csvText": { "type": "string", "example": "name,slug\nTest,test-slug" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import committed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "inserted": { "type": "integer" },
                        "updated": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/media-policy/soft-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Soft-delete a file",
        "operationId": "mediaPolicySoftDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "reason": { "type": "string", "example": "No longer needed" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File soft-deleted" }
        }
      }
    },
    "/auth/password/request": {
      "post": {
        "tags": ["Sales Onboarding"],
        "summary": "Send password reset email (Sales flow step 2)",
        "description": "After creating the user with a temporary password, Sales calls this to send the customer a password-reset link. The customer clicks the link and sets their own password. Always returns 204 regardless of whether the email exists (security by design).",
        "operationId": "salesPasswordResetRequest",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "b@acme.vn" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Password reset email sent (always 204, even if email not found)" }
        }
      }
    },
    "/media-policy/hard-delete": {
      "post": {
        "tags": ["Media Policy"],
        "summary": "Hard-delete a file permanently",
        "description": "Admin only. confirmFileId must match fileId.",
        "operationId": "mediaPolicyHardDelete",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileId", "confirmHardDelete", "confirmFileId"],
                "properties": {
                  "fileId": { "type": "string", "format": "uuid" },
                  "confirmHardDelete": { "type": "boolean" },
                  "confirmFileId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File permanently deleted" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Login: POST /auth/login {email, password} -> access_token"
      }
    }
  }
}
